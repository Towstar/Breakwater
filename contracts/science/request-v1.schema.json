{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Towstar/Breakwater/main/contracts/science/request-v1.schema.json",
  "title": "Reserved scientific worker requests v1; health remains the only implemented worker method",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "request_id", "method", "payload"],
  "properties": {
    "protocol_version": {"const": 1},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "method": {"enum": ["health", "capabilities", "storage_rollout", "pipe_transport"]},
    "payload": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"method": {"const": "health"}}}, "then": {"properties": {"payload": {"type": "object", "maxProperties": 0}}}},
    {"if": {"properties": {"method": {"const": "capabilities"}}}, "then": {"properties": {"payload": {"type": "object", "additionalProperties": false, "required": ["capability_version"], "properties": {"capability_version": {"const": 1}}}}}},
    {"if": {"properties": {"method": {"const": "storage_rollout"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/storage_payload"}}}},
    {"if": {"properties": {"method": {"const": "pipe_transport"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/pipe_payload"}}}}
  ],
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 256},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshot_id", "volume_run_id", "numerical_revision", "physical_hash"],
      "properties": {
        "snapshot_id": {"$ref": "#/$defs/identifier"},
        "volume_run_id": {"$ref": "#/$defs/identifier"},
        "numerical_revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "physical_hash": {"$ref": "#/$defs/sha256"},
        "route_id": {"$ref": "#/$defs/identifier"},
        "parameter_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "horizon": {"type": "number", "exclusiveMinimum": 0, "maximum": 24},
    "preview": {
      "type": "object", "additionalProperties": false,
      "required": ["max_times", "max_cells"],
      "properties": {
        "max_times": {"type": "integer", "minimum": 2, "maximum": 256},
        "max_cells": {"type": "integer", "minimum": 2, "maximum": 128}
      }
    },
    "network": {
      "description": "Project-v1 network, translated explicitly to native-member-name science mappings; runtime must apply the full existing project/native validation.",
      "type": "object", "additionalProperties": false, "required": ["assets", "routes"],
      "properties": {
        "assets": {"type": "array", "maxItems": 128, "items": {"type": "object", "required": ["id", "label", "kind"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "label": {"type": "string", "maxLength": 256}, "kind": {"enum": ["tank", "source", "treatment", "trucking"]}}}},
        "routes": {"type": "array", "maxItems": 256, "items": {"type": "object", "required": ["id", "source_id", "target_id", "capacity_m3h", "setpoint_m3h", "has_pump", "available", "cost_per_m3"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "source_id": {"$ref": "#/$defs/identifier"}, "target_id": {"$ref": "#/$defs/identifier"}, "capacity_m3h": {"type": "number", "minimum": 0}, "setpoint_m3h": {"type": "number", "minimum": 0}, "has_pump": {"type": "boolean"}, "available": {"type": "boolean"}, "cost_per_m3": {"type": "number", "minimum": 0}}}}
      }
    },
    "controls": {
      "type": "array", "maxItems": 384,
      "items": {"type": "object", "additionalProperties": false, "required": ["control_id", "value"], "properties": {"control_id": {"type": "string", "minLength": 1, "maxLength": 512}, "value": {"type": "number", "minimum": 0}}}
    },
    "storage_payload": {
      "type": "object", "additionalProperties": false,
      "required": ["method_version", "identity", "network", "controls", "horizon_h", "step_h", "derivatives", "preview"],
      "properties": {
        "method_version": {"const": 1}, "identity": {"$ref": "#/$defs/identity"},
        "network": {"$ref": "#/$defs/network"}, "controls": {"$ref": "#/$defs/controls"},
        "horizon_h": {"$ref": "#/$defs/horizon"}, "step_h": {"type": "number", "exclusiveMinimum": 0},
        "derivatives": {"type": "boolean"},
        "preview": {"type": "object", "additionalProperties": false, "required": ["max_times"], "properties": {"max_times": {"type": "integer", "minimum": 2, "maximum": 256}}}
      }
    },
    "pipe_payload": {
      "type": "object", "additionalProperties": false,
      "required": ["method_version", "identity", "parameters", "flow_m3h", "horizon_h", "preview"],
      "properties": {
        "method_version": {"const": 1},
        "identity": {"allOf": [{"$ref": "#/$defs/identity"}, {"required": ["route_id", "parameter_hash"]}]},
        "parameters": {"$ref": "pipe-parameters-v1.schema.json"},
        "flow_m3h": {"type": "number", "minimum": 0},
        "horizon_h": {"$ref": "#/$defs/horizon"}, "preview": {"$ref": "#/$defs/preview"}
      }
    }
  }
}
