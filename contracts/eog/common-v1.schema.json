{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Towstar/Breakwater/main/contracts/eog/common-v1.schema.json",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "time": {
      "type": "integer",
      "minimum": 0,
      "maximum": 253402300799
    },
    "source_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network.json",
        "ops.json",
        "telemetry.csv"
      ],
      "properties": {
        "network.json": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ops.json": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "telemetry.csv": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "captured_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 134217728
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "asset_id",
        "metric",
        "timestamp_unix",
        "value",
        "unit",
        "quality"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "asset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "metric": {
          "enum": [
            "inflow_bpd",
            "water_bpd",
            "status",
            "level_pct",
            "flow_bpd",
            "discharge_psi",
            "receive_flow_bpd",
            "pressure_psi"
          ]
        },
        "timestamp_unix": {
          "type": "integer",
          "minimum": 0,
          "maximum": 253402300799
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "enum": [
            "bpd",
            "state",
            "%",
            "psi"
          ]
        },
        "quality": {
          "enum": [
            "good",
            "stale",
            "missing",
            "unsupported"
          ]
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "system_id",
        "facility_id",
        "asset_id",
        "category",
        "state",
        "onset_unix",
        "onset_bounds",
        "updated_unix",
        "end_unix",
        "evidence_ids",
        "countdown_hours",
        "lost_revenue_per_hour",
        "coverage",
        "threshold_version",
        "recommended_action",
        "limitations"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "system_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "facility_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "asset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "category": {
          "enum": [
            "pipeline_leak",
            "pump_degradation",
            "pump_failure",
            "other"
          ]
        },
        "state": {
          "enum": [
            "ongoing",
            "resolved"
          ]
        },
        "onset_unix": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 253402300799
            },
            {
              "type": "null"
            }
          ]
        },
        "onset_bounds": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "earliest_unix",
                "latest_unix"
              ],
              "properties": {
                "earliest_unix": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 253402300799
                },
                "latest_unix": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 253402300799
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "updated_unix": {
          "type": "integer",
          "minimum": 0,
          "maximum": 253402300799
        },
        "end_unix": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 253402300799
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_ids": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "countdown_hours": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "lost_revenue_per_hour": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage": {
          "enum": [
            "available",
            "unavailable",
            "ambiguous"
          ]
        },
        "threshold_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "recommended_action": {
          "enum": [
            "field_inspection",
            "plan_required",
            "unavailable"
          ]
        },
        "limitations": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      }
    },
    "trip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arrival_unix",
        "volume_bbl",
        "cost"
      ],
      "properties": {
        "arrival_unix": {
          "type": "integer",
          "minimum": 0,
          "maximum": 253402300799
        },
        "volume_bbl": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cost": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "truck_job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "truck_id",
        "system_id",
        "facility_id",
        "called_unix",
        "response_min",
        "cycle_min",
        "trips",
        "available_again_unix"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "truck_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "system_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "facility_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "called_unix": {
          "type": "integer",
          "minimum": 0,
          "maximum": 253402300799
        },
        "response_min": {
          "type": "number",
          "minimum": 0
        },
        "cycle_min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "trips": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/trip"
          },
          "minItems": 1
        },
        "available_again_unix": {
          "type": "integer",
          "minimum": 0,
          "maximum": 253402300799
        }
      }
    },
    "well_shut_in": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "well_id",
        "facility_id",
        "start_unix",
        "end_unix"
      ],
      "properties": {
        "well_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "facility_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "start_unix": {
          "type": "integer",
          "minimum": 0,
          "maximum": 253402300799
        },
        "end_unix": {
          "type": "integer",
          "minimum": 0,
          "maximum": 253402300799
        }
      }
    },
    "repair_deadline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "facility_id",
        "repair_unix"
      ],
      "properties": {
        "facility_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "repair_unix": {
          "type": "integer",
          "minimum": 0,
          "maximum": 253402300799
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_id",
        "context",
        "start_unix",
        "repair_deadlines",
        "truck_jobs",
        "well_shut_ins",
        "inspection_assets",
        "plan_hash"
      ],
      "properties": {
        "plan_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "context": {
          "enum": [
            "snapshot_now",
            "historical_cursor"
          ]
        },
        "start_unix": {
          "type": "integer",
          "minimum": 0,
          "maximum": 253402300799
        },
        "repair_deadlines": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/repair_deadline"
          }
        },
        "truck_jobs": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/truck_job"
          }
        },
        "well_shut_ins": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/well_shut_in"
          }
        },
        "inspection_assets": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "plan_hash": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "truck_cost",
        "lost_revenue",
        "total"
      ],
      "properties": {
        "truck_cost": {
          "type": "number",
          "minimum": 0
        },
        "lost_revenue": {
          "type": "number",
          "minimum": 0
        },
        "total": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "trajectory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "facility_id",
        "tank_id",
        "capacity_bbl",
        "shutdown_volume_bbl",
        "times_unix",
        "volumes_bbl"
      ],
      "properties": {
        "facility_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "tank_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "capacity_bbl": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "shutdown_volume_bbl": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "times_unix": {
          "type": "array",
          "maxItems": 8192,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 253402300799
          },
          "minItems": 1
        },
        "volumes_bbl": {
          "type": "array",
          "maxItems": 8192,
          "items": {
            "type": "number"
          },
          "minItems": 1
        }
      }
    },
    "occupancy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "truck_id",
        "job_id",
        "start_unix",
        "end_unix"
      ],
      "properties": {
        "truck_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "job_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "start_unix": {
          "type": "integer",
          "minimum": 0,
          "maximum": 253402300799
        },
        "end_unix": {
          "type": "integer",
          "minimum": 0,
          "maximum": 253402300799
        }
      }
    },
    "violation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "asset_id",
        "time_unix"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "asset_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "time_unix": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 253402300799
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan",
        "feasible",
        "trajectories",
        "cost",
        "fleet_occupancy",
        "violations",
        "assumptions",
        "limitations"
      ],
      "properties": {
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "feasible": {
          "type": "boolean"
        },
        "trajectories": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/trajectory"
          }
        },
        "cost": {
          "$ref": "#/$defs/cost"
        },
        "fleet_occupancy": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/occupancy"
          }
        },
        "violations": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/violation"
          }
        },
        "assumptions": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "limitations": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validation_id",
        "plan_id",
        "evaluator_method",
        "validator_method",
        "independent",
        "feasible",
        "cost",
        "violations",
        "minimum_shutdown_margin_bbl",
        "evidence_ids",
        "plan_hash",
        "evidence"
      ],
      "properties": {
        "validation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "plan_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "evaluator_method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "validator_method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "independent": {
          "const": true
        },
        "feasible": {
          "type": "boolean"
        },
        "cost": {
          "$ref": "#/$defs/cost"
        },
        "violations": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/violation"
          }
        },
        "minimum_shutdown_margin_bbl": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_ids": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "plan_hash": {
          "$ref": "#/$defs/hash"
        },
        "evidence": {
          "type": "array",
          "maxItems": 32768,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "optimality",
        "evaluated_candidates",
        "candidate_limit",
        "time_limit_s",
        "elapsed_s",
        "complete"
      ],
      "properties": {
        "scope": {
          "enum": [
            "enumerated_space",
            "bounded_search"
          ]
        },
        "optimality": {
          "enum": [
            "proven_within_space",
            "best_found",
            "unavailable"
          ]
        },
        "evaluated_candidates": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "candidate_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "time_limit_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 120
        },
        "elapsed_s": {
          "type": "number",
          "minimum": 0
        },
        "complete": {
          "type": "boolean"
        }
      }
    }
  }
}
